{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "PlanResponseV1",
    "type": "object",
    "required": ["schema", "requestId", "agentId", "intentions"],
    "properties": {
      "schema": {
        "type": "string",
        "const": "PlanResponseV1"
      },
      "requestId": {
        "type": "string",
        "description": "Must exactly match the requestId provided by the game."
      },
      "agentId": {
        "type": "string",
        "description": "Must exactly match the agentId provided by the game."
      },
      "intentions": {
        "type": "array",
        "minItems": 1,
        "items": {
          "$ref": "#/definitions/intention"
        }
      },
      "questionsForNextContext": {
        "type": "array",
        "items": {
          "$ref": "#/definitions/question"
        }
      },
      "debug": {
        "type": "object",
        "properties": {
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "notes": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "definitions": {
      "intention": {
        "type": "object",
        "required": ["id", "type", "priority"],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "set_goal",
              "add_task",
              "propose_trap",
              "propose_dialogue",
              "request_observation",
              "update_beliefs",
              "noop"
            ]
          },
          "priority": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "rationale": {
            "type": "string",
            "maxLength": 400
          },
          "parameters": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "question": {
        "type": "object",
        "required": ["ask"],
        "properties": {
          "ask": { "type": "string" },
          "why": { "type": "string", "maxLength": 240 }
        }
      }
    }
  }