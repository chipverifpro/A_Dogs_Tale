--- !u!114 &1041234627
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1041234624}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b8956e57f4c814637862b21852297782, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DogGame.Lua.LuaAgentTest
  taskController: {fileID: 6544990386685219172}
  observer: {fileID: 6544990386685219154}
  reactToPerceptionEvents: 0
  sameEventTypeCooldownSeconds: 0.75
  luaScript: "function react(event)\n    if event ~= nil and event.hasScent then\n       
    print('Scent event: ' .. event.scentCategory .. ' ' .. event.scentName)\n       
    Bark(1)\n        Sniff(1.0)\n        FollowEventScent()\n        return\n   
    end\n\n    if event ~= nil and event.hasVision then\n        print('Vision event:
    ' .. event.visionKind .. ' dist=' .. event.visionDistanceMeters)\n        FaceEventTarget(8.0,
    1.0)\n        MoveToTarget(0.8)\n        return\n    end\n\n    if event ~= nil
    and event.hasSound then\n        print('Sound event: ' .. event.soundCategory
    .. '/' .. event.soundSubtype .. ' loud=' .. event.soundLoudness01)\n        MoveToEventSound(0.7)\n       
    if event.type == 'BarkHeard' then\n            Bark(1)\n        end\n       
    return\n    end\n\n    if Dog.isHungry and Vision.foodVisible then\n        print('Hungry
    and food visible')\n        Bark(1)\n        MoveToEvent(0.3)\n        return\n   
    end\n\n    if Hearing.barkHeard then\n        print('Heard a bark')\n       
    Bark(1)\n        return\n    end\n\n    print('Nothing interesting')\nend"
